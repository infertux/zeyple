#!/bin/bash

set -euxo pipefail

TYPE=${1:-deb}

cd "$(dirname "$0")"

# Lay out the files where Debian packages put them, with the sample config
# as the config and the man page compressed
build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT
install -D -m 755 ../zeyple/zeyple.py "$build/usr/sbin/zeyple"
install -D -m 644 ../zeyple/zeyple.conf.example "$build/etc/zeyple.conf"
mkdir -p "$build/usr/share/man/man8"
gzip -9n < ../zeyple/zeyple.8 > "$build/usr/share/man/man8/zeyple.8.gz"

fpm -f -s dir -t "$TYPE" -n zeyple \
    --vendor "infertux" \
    --maintainer "infertux" \
    --version "$(grep -E "^__version__ = '(.+)'$" ../zeyple/zeyple.py | cut -d\' -f2)" \
    --architecture all \
    --after-install after-install.sh \
    --before-remove before-remove.sh \
    --depends adduser \
    --depends gnupg \
    --depends python3-gpg \
    --depends sudo \
    --config-files /etc/zeyple.conf \
    -C "$build" \
    -p zeyple.deb \
    etc usr
