#!/bin/bash

set -euxo pipefail

TYPE=${1:-deb}

cd "$(dirname "$0")"

fpm -f -s dir -t "$TYPE" -n zeyple \
    --vendor "infertux" \
    --maintainer "infertux" \
    --version "$(grep -E "^__version__ = '(.+)'$" ../zeyple/zeyple.py | cut -d\' -f2)" \
    --architecture all \
    --after-install after-install.sh \
    --before-remove before-remove.sh \
    --depends adduser \
    --depends gnupg \
    --depends python3-gpg \
    --depends sudo \
    -C ../zeyple \
    -p zeyple.deb \
    zeyple.py=/usr/local/bin/zeyple.py \
    zeyple.conf.example=/usr/local/bin/zeyple.conf.example \
    zeyple.1=/usr/local/share/man/man1/zeyple.1
